# Copie vers .env.local pour le dev ; ne commite jamais de valeur réelle.
# Toute variable lue par le code doit figurer ici — src/lib/env.ts est la source
# de vérité du schéma, ce fichier en est le miroir documenté, et le hook
# pre-commit refuse le commit si les deux divergent.

# development | test | production
NODE_ENV=development

# Chemin du fichier SQLite, ou URL libsql:// d'une base Turso — le driver est le
# même dans les deux cas. En dev, un fichier local. En prod sur Vercel, le
# système de fichiers est éphémère : cette variable doit pointer sur Turso,
# sinon la base disparaît à chaque redéploiement.
DATABASE_PATH=./data/app.db

# Posé automatiquement par l'intégration Turso de Vercel, sous son nom à elle.
# Vide en dev : c'est DATABASE_PATH qui sert alors. Quand les deux sont là,
# celle-ci gagne — voir urlDeLaBase dans src/lib/env.ts.
TURSO_DATABASE_URL=

# Jeton d'accès Turso. Vide en dev (base locale, pas d'authentification) ; requis
# en prod si la base Turso est protégée. Une valeur vide est traitée comme
# absente, donc ce fichier reste copiable tel quel vers .env.local.
TURSO_AUTH_TOKEN=

# debug | info | warn | error | silent
LOG_LEVEL=info

# Port HTTP interne écouté par le serveur.
PORT=3000
